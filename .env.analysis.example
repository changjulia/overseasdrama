# PocketBase and its analysis worker must share this token.
# Prefer the generated local .analysis-worker-token instead of committing a value here.
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Alibaba Cloud Model Studio / Qwen-VL. Never commit the real key.
# DASHSCOPE_API_KEY is region-specific. The legacy Beijing endpoint below remains
# supported; production workspaces can replace it with their workspace domain.
DASHSCOPE_API_KEY=
LUMINA_SEMANTIC_PROVIDER=openai-chat-completions
LUMINA_SEMANTIC_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LUMINA_SEMANTIC_MODEL=qwen3-vl-plus
LUMINA_SEMANTIC_TIMEOUT=600
LUMINA_SEMANTIC_ENABLE_THINKING=false

# Local CPU defaults. Change device to cuda only on a compatible NVIDIA setup.
LUMINA_WHISPER_MODEL=small
LUMINA_WHISPER_DEVICE=cpu
LUMINA_WHISPER_COMPUTE_TYPE=int8
LUMINA_OCR_LANGUAGE=en
