/pb_data/data.db*
/pb_data/auxiliary.db*
/pb_data/backups/
/pb_data/types.d.ts
.pocketbase.*.log
.analysis-worker*.log
.codex-preview.*.log
pb-hook-test.*.log
/.analysis-worker-token
/tools/ffmpeg/
/tools/ffmpeg-release-essentials.zip
/.pnpm-store/
.codex-*.log
/tmp_content_factory_sources.txt
*.tsbuildinfo

# local video fixtures and processor outputs
/test-fixtures/
/analysis_cache/
**/edit/

# Python caches
__pycache__/
*.py[cod]
