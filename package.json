{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:full": "bash scripts/dev-with-services.sh",
    "pocketbase:setup": "bash scripts/setup-pocketbase.sh",
    "pocketbase:start": "bash scripts/start-pocketbase.sh",
    "workers:start": "bash scripts/start-analysis-workers.sh",
    "worker:start": "bash scripts/start-analysis-worker.sh",
    "runtime:check": "bash scripts/runtime-check.sh",
    "test:media-e2e": "python3 -m unittest -v tests.test_factory_render_media_e2e",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs && python3 -m unittest discover -v",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "ffmpeg-static": "5.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  },
  "type": "module"
}
