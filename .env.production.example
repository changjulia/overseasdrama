# Point this DNS name to the Singapore CVM before first start.
DOMAIN=lumina.43-156-182-61.sslip.io
ACME_EMAIL=ops@lingshu.site
LUMINA_WEB_PORT=3200
LUMINA_POCKETBASE_PORT=8190

# Generate with: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'replace-me'
BASIC_AUTH_USER=lumina
BASIC_AUTH_HASH='$2a$14$replace_with_a_real_caddy_hash'

LUMINA_WORKER_TOKEN=replace_with_at_least_32_random_characters

EXTERNAL_OPEN_API_BASE_URL=https://provider.example/api/open/v1
EXTERNAL_OPEN_API_KEY=replace_me

LUMINA_SEMANTIC_PROVIDER=openai-chat-completions
LUMINA_SEMANTIC_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LUMINA_SEMANTIC_API_KEY=replace_me
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
LUMINA_SEMANTIC_MODEL=qwen3-vl-plus
LUMINA_SEMANTIC_TIMEOUT=90
LUMINA_SEMANTIC_REQUEST_ATTEMPTS=1
LUMINA_SEMANTIC_DEBUG=false

LUMINA_WHISPER_MODEL=base
LUMINA_WHISPER_DEVICE=cpu
LUMINA_WHISPER_COMPUTE_TYPE=int8
LUMINA_WHISPER_CPU_THREADS=2
LUMINA_OCR_LANGUAGE=en
LUMINA_OCR_WORKERS=1
LUMINA_QWEN_SEGMENT_WORKERS=1
LUMINA_MATERIAL_FRAME_INTERVAL=10
LUMINA_MATERIAL_MAX_OCR_FRAMES=24
LUMINA_MATERIAL_MAX_SEMANTIC_FRAMES=12

# PocketBase uploaded files are migrated to Tencent COS through its S3-compatible
# storage settings after the first healthy start. Do not commit real credentials.
COS_BUCKET=lumina-prod-APPID
COS_REGION=ap-singapore
COS_ENDPOINT=https://cos.ap-singapore.myqcloud.com
COS_ACCESS_KEY_ID=replace_me
COS_SECRET_ACCESS_KEY=replace_me
