{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumina.local/schemas/preprod-attestation-v1.json",
  "title": "Lumina pre-production operational attestation",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "control", "environment", "executedAt", "releaseCommit", "result", "operator", "reviewer", "evidence"],
  "properties": {
    "schemaVersion": { "const": "preprod-attestation-v1" },
    "control": { "type": "string", "minLength": 3 },
    "environment": { "type": "string", "minLength": 3 },
    "executedAt": { "type": "string", "format": "date-time" },
    "releaseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "result": { "enum": ["passed", "failed"] },
    "operator": { "type": "string", "minLength": 2 },
    "reviewer": { "type": "string", "minLength": 2 },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "secretRedactionVerified": { "const": true },
    "signedUrlRedactionVerified": { "const": true },
    "notes": { "type": "string" }
  }
}
