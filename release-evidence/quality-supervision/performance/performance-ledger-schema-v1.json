{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-supervision/performance-ledger-v1",
  "title": "Performance acceptance ledger row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "unit_id", "case_id", "stage", "episode_or_asset_id", "chunk_index",
    "chunk_start_seconds", "chunk_end_seconds", "input_sha256", "model", "model_tier",
    "prompt_version", "started_at", "ended_at", "queue_wait_ms", "wall_clock_ms",
    "request_count", "retry_count", "cache_status", "cache_key", "terminal_status",
    "quality_gate", "output_sha256", "error_kind", "error_summary"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "unit_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["coarse", "detail", "precision", "hook", "match", "transition", "render", "qc"]},
    "episode_or_asset_id": {"type": ["string", "null"]},
    "chunk_index": {"type": ["integer", "null"], "minimum": 0},
    "chunk_start_seconds": {"type": ["number", "null"], "minimum": 0},
    "chunk_end_seconds": {"type": ["number", "null"], "minimum": 0},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model": {"type": "string", "minLength": 1},
    "model_tier": {"enum": ["flash", "max", "deterministic"]},
    "prompt_version": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "queue_wait_ms": {"type": "integer", "minimum": 0},
    "wall_clock_ms": {"type": "integer", "minimum": 0},
    "request_count": {"type": "integer", "minimum": 0},
    "retry_count": {"type": "integer", "minimum": 0},
    "retry_reasons": {"type": "array", "items": {"type": "string"}},
    "cache_status": {"enum": ["hit", "miss", "bypass"]},
    "cache_key": {"type": "string", "minLength": 1},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cost_amount": {"type": ["number", "null"], "minimum": 0},
    "cost_currency": {"type": ["string", "null"]},
    "terminal_status": {"enum": ["succeeded", "failed", "blocked", "cancelled", "paused", "needs_review"]},
    "quality_gate": {"enum": ["pass", "fail", "not_evaluated"]},
    "output_sha256": {"anyOf": [{"type": "string", "pattern": "^[a-f0-9]{64}$"}, {"type": "null"}]},
    "error_kind": {"type": ["string", "null"]},
    "error_summary": {"type": ["string", "null"]},
    "worker_id": {"type": ["string", "null"]},
    "provider_request_ids": {"type": "array", "items": {"type": "string"}},
    "software_version": {"type": ["string", "null"]},
    "cold_or_warm": {"enum": ["cold", "warm", "unknown"]}
  }
}
